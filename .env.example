# Copy this to .env.local for local dev
# In Vercel: add these under Settings → Environment Variables

# Your OpenRouter API key (keep this secret!)
OPENROUTER_API_KEY=sk-or-your-key-here

# Password your founders will use to access the app
# Make it strong: mix of words + numbers works well e.g. "alsisar-impact-2024"
APP_PASSWORD=your-chosen-password-here
